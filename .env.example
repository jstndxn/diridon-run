# Free token: https://511.org/open-data/token
FIVEONEONE_KEY=paste-your-511-token-here

# Optional overrides
PORT=8511
HOST=127.0.0.1      # 0.0.0.0 exposes the proxy, and your token, to your network
AGENCY=CT
STOP_DEP=70172      # Palo Alto, southbound platform
STOP_ARR=70262      # San Jose Diridon, southbound platform

# Cache lifetimes in seconds. 511 allows 60 requests/hour per token;
# these defaults use about 48/hour with both stops plus alerts.
TTL_DEPARTURES=120
TTL_ARRIVALS=300
TTL_ALERTS=600
HOURLY_CAP=55
